# ArogyaAI Environment Variables Template

# -------------------------------------------------------------
# DATABASE (MongoDB Atlas or Local MongoDB)
# -------------------------------------------------------------
DATABASE_URL="mongodb+srv://<username>:<password>@cluster0.mongodb.net/arogya_db?retryWrites=true&w=majority"

# -------------------------------------------------------------
# EXPRESS BACKEND SERVER
# -------------------------------------------------------------
PORT=5000
NODE_ENV=development
JWT_SECRET=super_secret_jwt_access_key_change_in_production
JWT_REFRESH_SECRET=super_secret_jwt_refresh_key_change_in_production
CORS_ORIGIN=http://localhost:5173

# -------------------------------------------------------------
# PYTHON AI / ML MICROSERVICE
# -------------------------------------------------------------
AI_SERVICE_URL=http://localhost:8000
GEMINI_API_KEY=your_gemini_api_key_here

# -------------------------------------------------------------
# CLOUDINARY (Media & Medical Reports)
# -------------------------------------------------------------
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# -------------------------------------------------------------
# REDIS (Medication Adherence Queue & Caching)
# -------------------------------------------------------------
REDIS_HOST=localhost
REDIS_PORT=6379
